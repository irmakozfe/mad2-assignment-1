{
  "expo": {
    "name": "assignment-app",
    "slug": "assignment-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "assignmentapp",
    "userInterfaceStyle": "automatic",
    "predictiveBackGestureEnabled": false
  },
  "web": {
    "output": "static"
  },
  "plugins": [
    "expo-router",
    [
      "expo-splash-screen",
      {
        "backgroundColor": "#208AEF"
      }
    ]
  ],
  "experiments": {
    "typedRoutes": true,
    "reactCompiler": true
  }
}
